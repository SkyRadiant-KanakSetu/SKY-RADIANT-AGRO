PORT=4100
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sky_radiant_agro
API_KEYS=ADMIN:change-me-admin-key,OPS:change-me-ops-key,VIEWER:change-me-viewer-key
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=200

# Real India mandi prices (AGMARKNET) via Open Government Data — register a free key at https://www.data.gov.in/
DATA_GOV_IN_API_KEY=
# Optional override if the dataset resource id changes
# OGD_MANDI_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070

# Demo-only synthetic prices (not real). Set false when DATA_GOV_IN_API_KEY is configured for production.
# If unset, synthetic fallback stays enabled so local/dev keeps working.
ENABLE_SYNTHETIC_MANDI_BOOTSTRAP=
